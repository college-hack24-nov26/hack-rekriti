# Backend Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/econova?retryWrites=true&w=majority

# JWT Token Secret for Authentication
JWT_SECRET=econova_secure_jwt_secret_token_2026

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://econovasmartbin-e45d7-default-rtdb.asia-southeast1.firebasedatabase.app/
